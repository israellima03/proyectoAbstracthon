---
import AppLayout from "../../layouts/AppLayout.astro";
import EncabezadoPerfil from "../../components/perfil/EncabezadoPerfil.astro";
import Estadisticas from "../../components/perfil/Estadisticas.astro";
import MensajeCecilio from "../../components/perfil/MensajeCecilio.astro";
import SeccionRacha from "../../components/perfil/SeccionRacha.astro";
import Preferencias from "../../components/perfil/Preferencias.astro";
import HojaRecompensas from "../../components/perfil/HojaRecompensas.astro";
---

<AppLayout titulo="Perfil">
  <div class="flex flex-col gap-5">
    <EncabezadoPerfil />
    <Estadisticas />
    <MensajeCecilio />
    <SeccionRacha />
    <Preferencias />
  </div>

  <button
    id="reiniciar-demo"
    type="button"
    class="mx-auto mt-6 block text-xs font-semibold text-tinta-suave underline underline-offset-4"
  >
    Reiniciar demo
  </button>

  <!-- Ventana flotante de recompensas -->
  <HojaRecompensas />
</AppLayout>

<script>
  import { reiniciarRacha } from "../../lib/racha";

  // Vuelve la racha al estado inicial (12 días, en riesgo)
  document.getElementById("reiniciar-demo")?.addEventListener("click", () => {
    reiniciarRacha();
    location.reload();
  });
</script>
