---
import AppLayout from "../../layouts/AppLayout.astro";
import ResumenAhorro from "../../components/ahorro/ResumenAhorro.astro";
import SugerenciaAhorro from "../../components/ahorro/SugerenciaAhorro.astro";
import ListaSubcuentas from "../../components/ahorro/ListaSubcuentas.astro";
---

<AppLayout titulo="Ahorro">
  <ResumenAhorro />
  <SugerenciaAhorro />
  <ListaSubcuentas />

  <button
    id="reiniciar-demo"
    type="button"
    class="mx-auto mt-6 block text-xs font-semibold text-tinta-suave underline underline-offset-4"
  >
    Reiniciar demo
  </button>
</AppLayout>

<script>
  import { iniciarAhorro } from "../../components/ahorro/ahorro-app";
  iniciarAhorro();
</script>
