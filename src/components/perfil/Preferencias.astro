---
import Icono from "../ui/Icono.astro";
---

<!-- Pendiente: todavía no se definió qué va en esta sección -->
<section class="flex flex-col gap-3">
  <h2 class="text-xl font-extrabold">Cuenta y seguridad</h2>

  <div class="flex items-center gap-3 rounded-2xl border-2 border-dashed border-tinta-suave bg-superficie/60 p-4">
    <span class="grid size-11 shrink-0 place-items-center rounded-xl border-2 border-dashed border-tinta-suave text-tinta-suave">
      <Icono nombre="escudo" class="size-5" />
    </span>
    <div class="min-w-0 flex-1">
      <p class="text-sm font-bold text-tinta-suave">Configuración de la cuenta</p>
      <p class="text-xs text-tinta-suave">Esta sección se definirá más adelante.</p>
    </div>
    <span class="chip shrink-0 bg-alerta-suave text-[10px] uppercase">Pendiente</span>
  </div>
</section>
