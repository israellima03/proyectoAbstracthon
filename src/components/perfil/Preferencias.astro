---
import Icono from "../ui/Icono.astro";
---

<!-- El plan del mes (sueldo y gastos fijos) vive en Inicio → "Planificar mes" -->
<section class="flex flex-col gap-3">
  <h2 class="text-xl font-extrabold">Cuenta y seguridad 🔒</h2>

  <button
    type="button"
    data-abrir="hoja-seguridad"
    class="tarjeta flex w-full items-center gap-3 p-3 text-left transition-transform active:translate-x-[2px] active:translate-y-[2px]"
  >
    <span class="grid size-11 shrink-0 place-items-center rounded-xl border-2 border-tinta bg-exito-suave text-exito">
      <Icono nombre="huella" class="size-5" />
    </span>
    <span class="min-w-0 flex-1">
      <span class="block text-sm leading-tight font-bold">
        Seguridad y <span class="text-primario">PIN biométrico</span>
      </span>
      <span data-resumen-seguridad class="mt-0.5 block truncate text-xs text-tinta-suave">Huella y PIN</span>
    </span>
    <span data-chip-seguridad class="chip shrink-0 bg-alerta-suave text-[10px] uppercase">Revisar</span>
    <span class="grid size-8 shrink-0 place-items-center rounded-lg border-2 border-tinta bg-superficie shadow-duro-sm">
      <Icono nombre="flecha" class="size-4" />
    </span>
  </button>
</section>
