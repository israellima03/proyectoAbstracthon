---
/**
 * Cecilio comenta tu racha y tu ahorro en UFV, y abre su chat (ChatFlotante + lib/chatbot.ts).
 * El mensaje se arma en el navegador con la racha guardada y el saldo de la pestaña UFVs.
 */
import Icono from "../ui/Icono.astro";

const preguntas = ["¿Cómo recupero mi racha?", "¿Cómo canjeo mis puntos?", "¿Qué es la UFV?"];
---

<section class="tarjeta overflow-hidden" aria-labelledby="cecilio-titulo">
  <!-- Cabecera tipo chat -->
  <header class="flex items-center gap-3 border-b-2 border-tinta bg-primario px-4 py-3 text-white">
    <div class="relative shrink-0">
      <span class="block size-12 overflow-hidden rounded-full border-2 border-tinta bg-primario">
        <img
          src="/img/mascota/BILLETE.jpg"
          alt="Cecilio, la mascota"
          width="48"
          height="48"
          class="size-full scale-150 object-cover"
        />
      </span>
      <span class="absolute right-0 bottom-0 size-3.5 rounded-full border-2 border-tinta bg-exito" aria-hidden="true"
      ></span>
    </div>
    <div class="min-w-0 flex-1">
      <h2 id="cecilio-titulo" class="leading-tight font-extrabold">Cecilio</h2>
      <p class="text-xs text-white/80">Tu asesor de ahorro · en línea</p>
    </div>
    <span data-cecilio-chip class="chip shrink-0 border-tinta bg-alerta-suave text-[10px] text-tinta uppercase">
      Tu racha
    </span>
  </header>

  <div class="p-4">
    <!-- Burbuja de mensaje -->
    <div class="relative rounded-2xl rounded-tl-sm border-2 border-tinta bg-fondo px-3 py-2.5 text-sm leading-snug">
      <p data-cecilio-titulo class="font-extrabold">Hola, Mateo</p>
      <p data-cecilio-texto class="mt-0.5">Estoy revisando tu racha…</p>
    </div>

    <!-- Dato de su ahorro en UFV -->
    <a
      href="/ufvs"
      class="mt-2 flex items-center gap-2 rounded-xl border-2 border-tinta bg-primario-suave px-3 py-2 text-xs"
    >
      <Icono nombre="ufvs" class="size-4 shrink-0 text-primario" />
      <span class="flex-1">
        Tus <b data-cecilio-ufv>0</b> UFV valen hoy <b data-cecilio-bs>Bs 0</b> y siguen el ritmo de la inflación.
      </span>
      <Icono nombre="flecha" class="size-3.5 shrink-0" />
    </a>

    <!-- Preguntas rápidas: se envían al chat de Cecilio -->
    <p class="mt-4 text-[11px] font-bold tracking-wide text-tinta-suave uppercase">Pregúntale a Cecilio</p>
    <div class="mt-2 flex flex-wrap gap-2">
      {
        preguntas.map((p) => (
          <button
            type="button"
            data-preguntar={p}
            class="chip bg-superficie py-1 shadow-duro-sm active:translate-x-px active:translate-y-px active:shadow-none"
          >
            {p}
          </button>
        ))
      }
    </div>

    <button
      type="button"
      data-abrir-chat
      class="mt-3 flex w-full items-center justify-center gap-2 rounded-[0.875rem] border-2 border-tinta bg-superficie py-2.5 text-sm font-bold shadow-duro-sm active:translate-x-[2px] active:translate-y-[2px] active:shadow-none"
    >
      <Icono nombre="chat" class="size-4" /> Escribirle a Cecilio
    </button>
  </div>
</section>

<script>
  import { usuario } from "../../data/perfil";
  import { siguienteHito } from "../../lib/racha";
  import { cargarCuenta } from "../../lib/cuenta-ufv";
  import { formatoBs, formatoUfv, ufvABs } from "../../lib/ufv";
  import { alCambiar } from "./estado";
  import { abrirChatCecilio, preguntarACecilio } from "./navegador";

  const uno = (sel: string) => document.querySelector<HTMLElement>(sel)!;

  // Saldo en UFV (pestaña UFVs)
  const saldo = cargarCuenta().saldoUfv;
  uno("[data-cecilio-ufv]").textContent = formatoUfv(saldo);
  uno("[data-cecilio-bs]").textContent = formatoBs(Math.round(ufvABs(saldo)));

  // Mensaje según la racha
  alCambiar((e) => {
    const nombre = usuario.nombreCorto;
    const chip = uno("[data-cecilio-chip]");
    let titulo: string;
    let texto: string;

    if (!e.ayerCumplido) {
      titulo = `${nombre}, tu racha está en riesgo`;
      texto = `Ayer no ahorraste. Si compras UFV hoy cubres lo de ayer y lo de hoy, y salvas tus ${e.dias} días.`;
      chip.textContent = "En riesgo";
    } else if (!e.hoyCumplido) {
      titulo = `Vas bien, ${nombre}`;
      texto = `Llevas ${e.dias} días seguidos. Te falta el ahorro de hoy: Bs ${e.montoDiario} o 1 UFV.`;
      chip.textContent = "Falta hoy";
    } else {
      const hito = siguienteHito(e.dias);
      titulo = `Racha al día, ${nombre}`;
      texto = `Ya ahorraste hoy y llevas ${e.dias} días. En ${hito.faltan} días más ganas el bonus de +${hito.puntos} pts.`;
      chip.textContent = `${e.dias} días`;
    }
    chip.classList.toggle("bg-alerta-suave", !e.ayerCumplido || !e.hoyCumplido);
    chip.classList.toggle("bg-exito-suave", e.ayerCumplido && e.hoyCumplido);
    uno("[data-cecilio-titulo]").textContent = titulo;
    uno("[data-cecilio-texto]").textContent = texto;
  });

  document.querySelectorAll<HTMLButtonElement>("[data-preguntar]").forEach((b) =>
    b.addEventListener("click", () => preguntarACecilio(b.dataset.preguntar!)),
  );
  uno("[data-abrir-chat]").addEventListener("click", abrirChatCecilio);
</script>
