---
/** Ventana flotante con todas las recompensas de la racha, filtrables por tipo. */
import HojaInferior from "./HojaInferior.astro";
import Icono from "../ui/Icono.astro";
import { categoriasPremio, premios, racha } from "../../data/perfil";
import { miles } from "./formato";

const tab = "flex-1 rounded-lg py-2 text-xs font-bold transition-colors";
---

<HojaInferior
  id="hoja-recompensas"
  titulo="Recompensas"
  subtitulo="Canjea tus puntos de racha"
  icono="estrella"
  colorIcono="bg-alerta-suave text-tinta"
>
  <!-- Saldo -->
  <div class="flex items-center justify-between rounded-xl border-2 border-tinta bg-primario-suave px-3 py-2.5">
    <p class="text-xs font-bold">Tienes</p>
    <p class="text-xl font-extrabold text-primario">
      <span data-puntos>{miles(racha.puntos)}</span> <span class="text-sm">pts</span>
    </p>
  </div>

  <!-- Filtros -->
  <div class="mt-3 flex gap-1 rounded-xl border-2 border-tinta bg-fondo p-1" role="tablist" aria-label="Tipo de recompensa">
    {
      categoriasPremio.map((c, i) => (
        <button
          type="button"
          role="tab"
          data-categoria={c.id}
          aria-selected={i === 0 ? "true" : "false"}
          class:list={[tab, i === 0 ? "bg-primario text-white" : "text-tinta-suave"]}
        >
          {c.etiqueta}
        </button>
      ))
    }
  </div>

  <!-- Catálogo -->
  <ul class="mt-4 grid grid-cols-2 gap-3">
    {
      premios.map((p) => {
        const alcanza = racha.puntos >= p.costo;
        return (
          <li data-premio={p.categoria} class="tarjeta flex flex-col gap-2 p-3">
            <div class="flex items-start justify-between">
              <span class="grid size-10 place-items-center rounded-xl border-2 border-tinta bg-primario-suave text-primario">
                <Icono nombre={p.icono} class="size-5" />
              </span>
              <span class="chip bg-alerta-suave text-[11px]">{miles(p.costo)} pts</span>
            </div>
            <div>
              <p class="text-sm leading-tight font-bold">{p.titulo}</p>
              <p class="mt-0.5 text-xs text-tinta-suave">{p.detalle}</p>
            </div>
            <button
              type="button"
              data-canjear={p.id}
              data-costo={p.costo}
              disabled={!alcanza}
              class="btn-accion mt-auto w-full py-2 text-xs disabled:bg-linea disabled:text-tinta-suave disabled:shadow-none"
            >
              {alcanza ? "Canjear" : `Faltan ${miles(p.costo - racha.puntos)} pts`}
            </button>
          </li>
        );
      })
    }
  </ul>

  <!-- Historial de canjes -->
  <div data-canjes hidden class="mt-5">
    <p class="mb-2 text-[11px] font-bold tracking-wide text-tinta-suave uppercase">Tus canjes</p>
    <ul data-canjes-lista class="tarjeta divide-y-2 divide-linea overflow-hidden text-sm"></ul>
  </div>

  <p class="mt-4 flex gap-1.5 rounded-lg bg-primario-suave p-2 text-[11px] text-primario">
    <Icono nombre="llama" class="size-3.5 shrink-0" />
    Los puntos se ganan por constancia, no por monto: +{racha.puntosPorDia} pts por cada día de racha.
  </p>
</HojaInferior>

<script>
  import { alCambiar, canjear } from "./estado";
  import { miles } from "./formato";
  import { avisar } from "./navegador";

  const tabs = document.querySelectorAll<HTMLButtonElement>("[data-categoria]");
  const items = document.querySelectorAll<HTMLElement>("[data-premio]");
  const botones = document.querySelectorAll<HTMLButtonElement>("[data-canjear]");

  function filtrar(categoria: string) {
    tabs.forEach((t) => {
      const activo = t.dataset.categoria === categoria;
      t.setAttribute("aria-selected", String(activo));
      t.classList.toggle("bg-primario", activo);
      t.classList.toggle("text-white", activo);
      t.classList.toggle("text-tinta-suave", !activo);
    });
    items.forEach((li) => (li.hidden = categoria !== "todas" && li.dataset.premio !== categoria));
  }

  tabs.forEach((t) => t.addEventListener("click", () => filtrar(t.dataset.categoria!)));

  // Los accesos rápidos de la tarjeta abren la ventana ya filtrada
  document.querySelectorAll<HTMLElement>("[data-ir-categoria]").forEach((b) =>
    b.addEventListener("click", () => filtrar(b.dataset.irCategoria!)),
  );
  document
    .querySelectorAll<HTMLElement>('[data-abrir="hoja-recompensas"]:not([data-ir-categoria])')
    .forEach((b) => b.addEventListener("click", () => filtrar("todas")));

  alCambiar((e) => {
    botones.forEach((b) => {
      const costo = Number(b.dataset.costo);
      b.disabled = e.puntos < costo;
      b.textContent = b.disabled ? `Faltan ${miles(costo - e.puntos)} pts` : "Canjear";
    });
  });

  botones.forEach((b) =>
    b.addEventListener("click", () => {
      const premio = canjear(b.dataset.canjear!);
      if (!premio) return;
      avisar(premio.mensaje, "exito", `Canjeaste ${premio.titulo}`);

      const fila = document.createElement("li");
      fila.className = "flex items-center justify-between gap-2 px-3 py-2";
      fila.innerHTML = `<span class="font-semibold"></span><span class="shrink-0 text-xs font-bold text-peligro">-${miles(premio.costo)} pts</span>`;
      fila.firstElementChild!.textContent = premio.titulo;
      document.querySelector("[data-canjes-lista]")!.prepend(fila);
      document.querySelector<HTMLElement>("[data-canjes]")!.hidden = false;
    }),
  );
</script>
