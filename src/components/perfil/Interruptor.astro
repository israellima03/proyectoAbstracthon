---
/** Interruptor encendido/apagado (es un checkbox, funciona dentro de un <form>). */
interface Props {
  nombre: string;
  etiqueta: string;
  detalle?: string;
  activo?: boolean;
}

const { nombre, etiqueta, detalle, activo = false } = Astro.props;
---

<label class="flex cursor-pointer items-center gap-3">
  <span class="min-w-0 flex-1">
    <span class="block text-sm font-bold">{etiqueta}</span>
    {detalle && <span class="block text-xs text-tinta-suave">{detalle}</span>}
  </span>
  <input type="checkbox" name={nombre} checked={activo} class="peer sr-only" />
  <span
    aria-hidden="true"
    class="relative h-7 w-12 shrink-0 rounded-full border-2 border-tinta bg-linea transition-colors peer-checked:bg-exito peer-focus-visible:ring-2 peer-focus-visible:ring-primario-claro peer-checked:[&>span]:translate-x-5"
  >
    <span class="absolute top-0.5 left-0.5 size-5 rounded-full border-2 border-tinta bg-superficie transition-transform"
    ></span>
  </span>
</label>
