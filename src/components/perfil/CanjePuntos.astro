---
import Icono from "../ui/Icono.astro";
import { premios, racha } from "../../data/perfil";
import { miles } from "./formato";
---

<div class="flex flex-col gap-2.5">
  <div class="flex items-center justify-between">
    <h3 class="text-lg font-extrabold">Canjea tus puntos</h3>
    <span class="chip bg-superficie">
      <Icono nombre="estrella" class="size-3.5 fill-alerta text-tinta" trazo={1.75} />
      <span data-puntos>{miles(racha.puntos)}</span> pts
    </span>
  </div>

  <ul class="-mx-4 flex snap-x scroll-px-4 gap-3 overflow-x-auto px-4 pt-0.5 pb-2 [scrollbar-width:none]">
    {
      premios.map((p) => {
        const alcanza = racha.puntos >= p.costo;
        return (
          <li class="flex w-40 shrink-0 snap-start flex-col gap-2 rounded-2xl border-2 border-tinta bg-superficie p-3 shadow-duro">
            <div class="flex items-start justify-between">
              <span class="grid size-10 place-items-center rounded-xl border-2 border-tinta bg-primario-suave text-primario">
                <Icono nombre={p.icono} class="size-5" />
              </span>
              <span class="text-xs font-extrabold">{miles(p.costo)} pts</span>
            </div>
            <div>
              <p class="text-sm leading-tight font-bold">{p.titulo}</p>
              <p class="mt-0.5 text-xs text-tinta-suave">{p.detalle}</p>
            </div>
            <button
              type="button"
              data-canjear={p.id}
              data-costo={p.costo}
              disabled={!alcanza}
              class="btn-accion mt-auto w-full py-2 text-sm disabled:bg-linea disabled:text-tinta-suave disabled:shadow-none"
            >
              {alcanza ? "Canjear" : `Faltan ${miles(p.costo - racha.puntos)} pts`}
            </button>
          </li>
        );
      })
    }
  </ul>
</div>

<script>
  import { alCambiar, canjear } from "./estado";
  import { miles } from "./formato";
  import { avisar } from "./navegador";

  const botones = document.querySelectorAll<HTMLButtonElement>("[data-canjear]");

  alCambiar((e) => {
    document.querySelectorAll("[data-puntos]").forEach((el) => (el.textContent = miles(e.puntos)));
    botones.forEach((b) => {
      const costo = Number(b.dataset.costo);
      b.disabled = e.puntos < costo;
      b.textContent = b.disabled ? `Faltan ${miles(costo - e.puntos)} pts` : "Canjear";
    });
  });

  botones.forEach((b) =>
    b.addEventListener("click", () => {
      const premio = canjear(b.dataset.canjear!);
      if (premio) avisar(premio.mensaje);
    }),
  );
</script>
