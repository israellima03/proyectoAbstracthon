---
import TarjetaRacha from "./TarjetaRacha.astro";
import RetosHoy from "./RetosHoy.astro";
import TarjetaRecompensas from "./TarjetaRecompensas.astro";
---

<!-- Racha de ahorro (idea 6): constancia diaria → puntos → recompensas -->
<section id="racha" class="flex scroll-mt-4 flex-col gap-3">
  <h2 class="text-xl font-extrabold">Tu racha 🔥</h2>
  <TarjetaRacha />
  <RetosHoy />
  <h3 class="mt-2 text-xl font-extrabold">Recompensas 🎁</h3>
  <TarjetaRecompensas />
</section>
