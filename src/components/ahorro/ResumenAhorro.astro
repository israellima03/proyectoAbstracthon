---
import Icono from "../ui/Icono.astro";
import AnuncioBanco from "../ui/AnuncioBanco.astro";
---

<!-- Encabezado -->
<header class="mb-4 flex items-start justify-between gap-3">
  <div>
    <span class="chip bg-primario-suave text-[10px] tracking-wide text-primario uppercase">
      <Icono nombre="escudo" class="size-3" trazo={2.5} /> Escudo anti-inflación
    </span>
    <h1 class="mt-2 text-3xl leading-tight font-extrabold tracking-tight">Ahorro en UFV</h1>
  </div>
  <a
    href="/ufvs"
    aria-label="Ver evolución de la UFV"
    class="grid size-11 shrink-0 place-items-center rounded-xl border-2 border-tinta bg-superficie shadow-duro-sm active:translate-x-[2px] active:translate-y-[2px] active:shadow-none"
  >
    <Icono nombre="ufvs" class="size-5" />
  </a>
</header>

<!-- Total ahorrado -->
<section class="tarjeta p-4">
  <p class="text-[11px] font-bold tracking-wide text-tinta-suave uppercase">Total ahorrado</p>
  <p class="mt-1 text-3xl font-extrabold text-primario">
    <span id="total-ufv">0,00</span> <span class="text-base">UFV</span>
  </p>
  <p class="text-sm text-tinta-suave">≈ <span id="total-bs">Bs 0</span></p>

  <div class="mt-3 h-3 overflow-hidden rounded-full border-2 border-tinta bg-fondo">
    <div id="total-barra" class="h-full bg-primario transition-all duration-500" style="width:0%"></div>
  </div>
  <p class="mt-2 flex items-center gap-1.5 text-[11px] text-tinta-suave">
    <Icono nombre="escudo" class="size-3.5 text-primario" />
    <span><span id="total-progreso" class="font-bold text-tinta">0%</span> de todas tus metas · tu dinero no pierde valor</span>
  </p>
  <AnuncioBanco class="mt-4" />
</section>
