---
import Icono from "../ui/Icono.astro";
import { retos } from "../../data/perfil";

const boton =
  "grid size-10 shrink-0 place-items-center rounded-xl border-2 border-tinta bg-accion text-white shadow-duro-sm active:translate-x-[2px] active:translate-y-[2px] active:shadow-none group-data-[listo=true]:hidden";
---

<div class="flex flex-col gap-2.5">
  <h3 class="text-xl font-extrabold">Retos de hoy</h3>
  <ul class="flex flex-col gap-2.5">
    {
      retos.map((r) => (
        <li
          data-reto={r.id}
          data-listo={String(Boolean(r.listo))}
          class="group flex items-center gap-3 rounded-2xl border-2 border-tinta bg-superficie p-3 shadow-duro transition-colors data-[listo=true]:bg-exito-suave"
        >
          <span class="grid size-10 shrink-0 place-items-center rounded-xl border-2 border-tinta bg-primario-suave text-primario group-data-[listo=true]:bg-exito group-data-[listo=true]:text-white">
            <Icono nombre={r.icono} class="size-5 group-data-[listo=true]:hidden" />
            <Icono nombre="check" class="hidden size-5 group-data-[listo=true]:block" trazo={3} />
          </span>
          <div class="min-w-0 flex-1">
            <p class="text-sm leading-tight font-bold">{r.titulo}</p>
            <p class="mt-0.5 text-xs font-semibold text-primario group-data-[listo=true]:text-exito">
              +{r.puntos} pts
              <span class="hidden group-data-[listo=true]:inline">&nbsp;ganados</span>
              {r.detalle && (
                <span data-reto-detalle class="font-medium text-tinta-suave group-data-[listo=true]:hidden">&nbsp;· {r.detalle}</span>
              )}
            </p>
          </div>
          <span class="hidden text-xs font-extrabold text-exito group-data-[listo=true]:block">Listo</span>
          <a href={r.accion.href} aria-label={r.titulo} class={boton}>
            <Icono nombre="flecha" class="size-4" />
          </a>
        </li>
      ))
    }
  </ul>
</div>

<script>
  import { alCambiar, pagosSinTipo } from "../perfil/estado";

  const items = document.querySelectorAll<HTMLElement>("[data-reto]");

  // Cuántos pagos faltan clasificar (dato de la pestaña Pagos)
  const detallePagos = document.querySelector('[data-reto="clasificar-pagos"] [data-reto-detalle]');
  if (detallePagos && pagosSinTipo > 0) {
    detallePagos.textContent = ` · ${pagosSinTipo} ${pagosSinTipo === 1 ? "pendiente" : "pendientes"} en Pagos`;
  }

  alCambiar((e) => {
    items.forEach((el) => (el.dataset.listo = String(e.retosListos.includes(el.dataset.reto!))));
  });
</script>
