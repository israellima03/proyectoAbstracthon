---
/**
 * Panel que sube desde abajo dentro del celular.
 * Se abre con cualquier botón que tenga `data-abrir="<id>"`.
 */
import Icono from "../ui/Icono.astro";
import type { NombreIcono } from "../ui/iconos";

interface Props {
  id: string;
  titulo: string;
  subtitulo?: string;
  icono: NombreIcono;
  /** Clases del cuadrito del ícono (fondo y color). */
  colorIcono?: string;
}

const { id, titulo, subtitulo, icono, colorIcono = "bg-primario-suave text-primario" } = Astro.props;
---

<div
  id={id}
  hidden
  data-hoja
  role="dialog"
  aria-modal="true"
  aria-labelledby={`${id}-titulo`}
  class="absolute inset-0 z-[60] flex flex-col justify-end"
>
  <div data-cerrar class="absolute inset-0 bg-tinta/50"></div>

  <section
    class="relative flex max-h-[90%] flex-col overflow-hidden rounded-t-3xl border-2 border-b-0 border-tinta bg-fondo"
  >
    <header class="flex items-center gap-3 border-b-2 border-tinta bg-superficie px-4 py-3">
      <span class:list={["grid size-10 shrink-0 place-items-center rounded-xl border-2 border-tinta", colorIcono]}>
        <Icono nombre={icono} class="size-5" />
      </span>
      <div class="min-w-0 flex-1">
        <h2 id={`${id}-titulo`} class="leading-tight font-extrabold">{titulo}</h2>
        {subtitulo && <p class="text-xs text-tinta-suave">{subtitulo}</p>}
      </div>
      <button
        type="button"
        data-cerrar
        data-cerrar-boton
        aria-label="Cerrar"
        class="grid size-9 place-items-center rounded-xl border-2 border-tinta bg-superficie shadow-duro-sm active:translate-x-[2px] active:translate-y-[2px] active:shadow-none"
      >
        <Icono nombre="cerrar" class="size-4" />
      </button>
    </header>

    <div class="flex-1 overflow-y-auto overscroll-contain p-4">
      <slot />
    </div>

    <slot name="pie" />
  </section>
</div>

<script>
  import { abrirHoja } from "../perfil/navegador";

  document.addEventListener("click", (ev) => {
    const objetivo = ev.target as HTMLElement;
    const abrir = objetivo.closest<HTMLElement>("[data-abrir]");
    if (abrir) return abrirHoja(abrir.dataset.abrir!);
    const cerrar = objetivo.closest<HTMLElement>("[data-cerrar]");
    const hoja = cerrar?.closest<HTMLElement>("[data-hoja]");
    if (hoja) hoja.hidden = true;
  });

  document.addEventListener("keydown", (ev) => {
    if (ev.key !== "Escape") return;
    document.querySelectorAll<HTMLElement>("[data-hoja]").forEach((h) => (h.hidden = true));
  });
</script>
