---
import Icono from "../ui/Icono.astro";
import ChatMetas from "./ChatMetas.astro";

const mascota = "/img/mascota/BILLETE.jpg";
const nombre = "Cecilio";
---

<!-- Capa sobre la pantalla del celular (el padre del layout es `relative`) -->
<div class="pointer-events-none absolute inset-0 z-50">
  <!-- Boton flotante: unico boton de chat de la app -->
  <button
    id="chat-boton"
    type="button"
    aria-expanded="false"
    aria-controls="chat-panel"
    class="pointer-events-auto absolute right-4 bottom-[calc(5.5rem+env(safe-area-inset-bottom))] size-14 transition-transform hover:-translate-y-0.5 active:translate-x-[2px] active:translate-y-[2px] sm:bottom-[6.25rem]"
  >
    <span class="block size-full overflow-hidden rounded-full border-2 border-tinta bg-primario shadow-duro-sm">
      <!-- La mascota ocupa el centro de la imagen cuadrada; scale-150 acerca la cara -->
      <img
        src={mascota}
        alt={`Abrir chat con ${nombre}`}
        width="56"
        height="56"
        class="size-full scale-150 object-cover"
      />
    </span>
    <span
      class="absolute -top-1 -right-1 size-4 rounded-full border-2 border-tinta bg-alerta"
      aria-hidden="true"></span>
  </button>

  <!--
    Burbuja de aviso a la izquierda del boton. Oculta por defecto (inert = sin foco
    ni lector de pantalla); el script le pone data-visible durante 3 s cada 10 s.
  -->
  <button
    id="chat-aviso"
    type="button"
    inert
    class="pointer-events-none absolute right-[5.25rem] bottom-[calc(6.25rem+env(safe-area-inset-bottom))] translate-x-2 rounded-2xl border-2 border-tinta bg-superficie px-3 py-2 text-sm font-bold whitespace-nowrap opacity-0 shadow-duro-sm transition-[opacity,translate] duration-300 data-[visible]:pointer-events-auto data-[visible]:translate-x-0 data-[visible]:opacity-100 motion-reduce:transition-none sm:bottom-[7rem]"
  >
    Usa tu asistente virtual
    <!-- Pico de la nube apuntando al boton -->
    <span
      class="absolute top-1/2 -right-[7px] size-3 -translate-y-1/2 rotate-45 border-t-2 border-r-2 border-tinta bg-superficie"
      aria-hidden="true"></span>
  </button>

  <!-- Hoja inferior: fondo oscuro + panel. Oculta por defecto. -->
  <div id="chat-capa" hidden class="pointer-events-auto absolute inset-0">
    <div id="chat-fondo" class="absolute inset-0 bg-tinta/50" aria-hidden="true"></div>

    <section
      id="chat-panel"
      role="dialog"
      aria-modal="true"
      aria-label={`Chat con ${nombre}`}
      class="absolute inset-x-0 bottom-0 flex h-[85%] flex-col overflow-hidden rounded-t-3xl border-2 border-b-0 border-tinta bg-fondo pb-[env(safe-area-inset-bottom)]"
    >
      <!-- Cabecera -->
      <header class="flex items-center gap-3 border-b-2 border-tinta bg-superficie px-4 py-3">
        <img
          src={mascota}
          alt=""
          width="44"
          height="44"
          class="size-11 shrink-0 rounded-full border-2 border-tinta object-cover"
        />
        <div class="flex-1">
          <h2 class="text-lg leading-tight font-extrabold">{nombre}</h2>
          <p class="flex items-center gap-1.5 text-xs text-tinta-suave">
            <span class="size-2 rounded-full bg-exito" aria-hidden="true"></span>
            En linea
          </p>
        </div>
        <button
          id="chat-cerrar"
          type="button"
          aria-label="Cerrar chat"
          class="grid size-9 shrink-0 place-items-center rounded-xl border-2 border-tinta bg-superficie shadow-duro-sm active:translate-x-[2px] active:translate-y-[2px] active:shadow-none"
        >
          <Icono nombre="cerrar" class="size-4" />
        </button>
      </header>

      <!-- Mensajes + pie fijo (chips y campo de texto) -->
      <ChatMetas />
    </section>
  </div>
</div>

<script>
  const boton = document.getElementById("chat-boton") as HTMLButtonElement;
  const capa = document.getElementById("chat-capa") as HTMLDivElement;
  const fondo = document.getElementById("chat-fondo") as HTMLDivElement;
  const cerrar = document.getElementById("chat-cerrar") as HTMLButtonElement;
  const metas = capa.querySelector<HTMLDivElement>("[data-chat-metas]")!;
  const input = metas.querySelector<HTMLInputElement>("[data-input]")!;

  // Burbuja de aviso: aparece cada 10 s y se queda visible 3 s
  const aviso = document.getElementById("chat-aviso") as HTMLButtonElement;
  const CADA_MS = 10_000;
  const VISIBLE_MS = 3_000;
  let temporizadorOcultar: number | undefined;

  function mostrarAviso(visible: boolean) {
    aviso.toggleAttribute("data-visible", visible);
    aviso.inert = !visible;
  }

  setInterval(() => {
    if (!capa.hidden) return; // con el chat abierto no se muestra
    mostrarAviso(true);
    clearTimeout(temporizadorOcultar);
    temporizadorOcultar = window.setTimeout(() => mostrarAviso(false), VISIBLE_MS);
  }, CADA_MS);

  aviso.addEventListener("click", () => abrir(true));

  function abrir(abierto: boolean) {
    if (abierto) {
      clearTimeout(temporizadorOcultar);
      mostrarAviso(false);
    }
    capa.hidden = !abierto;
    boton.setAttribute("aria-expanded", String(abierto));
    if (abierto) {
      // Se avisa con la capa ya visible: oculta no tiene altura y no se podria bajar el scroll
      metas.dispatchEvent(new CustomEvent("chat:abrir"));
      input.focus();
    } else boton.focus();
  }

  boton.addEventListener("click", () => abrir(true));
  cerrar.addEventListener("click", () => abrir(false));
  fondo.addEventListener("click", () => abrir(false));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !capa.hidden) abrir(false);
  });
</script>
