---
import { iconos, type NombreIcono } from "./iconos";

interface Props {
  nombre: NombreIcono;
  class?: string;
  /** Grosor del trazo */
  trazo?: number;
}

const { nombre, class: clase = "size-6", trazo = 2 } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={trazo}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={clase}
  aria-hidden="true"
  set:html={iconos[nombre]}
/>
