---
/**
 * Gráfico 1: cotización de la UFV en los últimos meses (SVG generado en el servidor).
 */
import Icono from "../ui/Icono.astro";
import { HISTORIAL_UFV, VALOR_UFV, formatoCotizacion, formatoUfv } from "../../lib/ufv";

const inicio = HISTORIAL_UFV[0];
const crecimiento = (VALOR_UFV / inicio.valor - 1) * 100;
const meses = HISTORIAL_UFV.length;

// Ejemplo: 100 UFV comprados en el primer mes del gráfico
const ejemploUfv = 100;
const bsAntes = ejemploUfv * inicio.valor;
const bsHoy = ejemploUfv * VALOR_UFV;

// Geometría del gráfico
const ancho = 300;
const alto = 140;
const margen = { x: 22, arriba: 22, abajo: 22 };
const valores = HISTORIAL_UFV.map((p) => p.valor);
const min = Math.min(...valores) - 0.004;
const max = Math.max(...valores) + 0.004;
const puntos = HISTORIAL_UFV.map((p, i) => ({
  ...p,
  x: margen.x + (i * (ancho - margen.x * 2)) / (meses - 1),
  y: margen.arriba + ((max - p.valor) / (max - min)) * (alto - margen.arriba - margen.abajo),
}));
const linea = puntos.map((p, i) => `${i ? "L" : "M"}${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(" ");
const base = alto - margen.abajo;
const area = `${linea} L${puntos.at(-1)!.x},${base} L${puntos[0].x},${base} Z`;
---

<section class="tarjeta mt-5 p-4">
  <div class="flex items-start justify-between gap-2">
    <div>
      <p class="text-[11px] font-bold tracking-wide text-tinta-suave uppercase">Cotización oficial hoy</p>
      <p class="text-xl font-extrabold">1 UFV = Bs {formatoCotizacion(VALOR_UFV)}</p>
    </div>
    <span class="chip shrink-0 bg-exito-suave text-exito">↑ +{crecimiento.toFixed(2).replace(".", ",")}%</span>
  </div>
  <p class="mt-1 text-xs text-tinta-suave">Así subió la UFV en los últimos {meses} meses</p>

  <div class="mt-3 rounded-xl border-2 border-tinta bg-fondo p-2">
    <svg
      viewBox={`0 0 ${ancho} ${alto}`}
      class="w-full"
      role="img"
      aria-label={`La UFV subió de ${formatoCotizacion(inicio.valor)} en ${inicio.nombre} a ${formatoCotizacion(VALOR_UFV)} hoy`}
    >
      <line x1={margen.x} x2={ancho - margen.x} y1={base} y2={base} class="stroke-linea" stroke-width="1" />
      <path d={area} class="fill-primario-suave" />
      <path d={linea} fill="none" class="stroke-primario" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
      {
        puntos.map((p, i) => {
          const ultimo = i === meses - 1;
          return (
            <g>
              <text x={p.x} y={p.y - 9} text-anchor="middle" class:list={["text-[8px]", ultimo ? "fill-primario font-extrabold" : "fill-tinta-suave"]}>
                {formatoCotizacion(p.valor)}
              </text>
              <circle cx={p.x} cy={p.y} r={ultimo ? 5 : 3.5} class:list={[ultimo ? "fill-primario" : "fill-superficie", "stroke-tinta"]} stroke-width="2" />
              <text x={p.x} y={alto - 6} text-anchor="middle" class="fill-tinta text-[9px] font-bold">
                {ultimo ? "Hoy" : p.etiqueta}
              </text>
            </g>
          );
        })
      }
    </svg>
  </div>

  <div class="mt-3 flex gap-2 rounded-xl border-2 border-tinta bg-alerta-suave p-3 text-xs leading-relaxed">
    <span class="text-base">💡</span>
    <p>
      <b>Ejemplo:</b> quien compró <b>{ejemploUfv} UFV</b> en {inicio.nombre} pagó <b>Bs {formatoUfv(bsAntes)}</b>.
      Hoy valen <b>Bs {formatoUfv(bsHoy)}</b>: ganó <b class="text-exito">+Bs {formatoUfv(bsHoy - bsAntes)}</b> sin hacer nada.
    </p>
  </div>
  <p class="mt-2 flex items-center gap-1 text-[10px] text-tinta-suave">
    <Icono nombre="ufvs" class="size-3" /> Valores de ejemplo (reemplazar por los oficiales del BCB).
  </p>
</section>
