
---
import PlanificarMesModal from "./PlanificarMesModal.astro";
---

<div class="space-y-5">
  <!-- Saludo + Botón Planificar mes -->
  <div class="flex items-center justify-between gap-2">
    <div>
      <p class="text-sm font-medium text-[#1E1B4B]/75">Hola, Camila</p>
      <h1 class="text-2xl font-extrabold tracking-tight text-[#1E1B4B]">
        Tus cuentas hoy
      </h1>
    </div>

    <button
      id="btn-abrir-plan-mes"
      type="button"
      class="rounded-xl border-2 border-[#1E1B4B] bg-[#F4ECE1] px-3 py-2 text-xs font-extrabold text-[#1E1B4B] shadow-[0_3px_0_#1E1B4B] active:translate-y-0.5"
    >
      Planificar mes
    </button>
  </div>

  <!-- AQUÍ VAN TUS 3 TARJETAS Y MODALES DE PAGAR / COBRAR EXISTENTES -->
</div> <br>

<!-- COMPONENTE SEPARADO DE PLANIFICAR MES -->
<PlanificarMesModal />

<script>
  // ... tu script anterior ...

  document.getElementById("btn-abrir-plan-mes")?.addEventListener("click", () => {
    const modalPlan = document.getElementById("modal-planificar-mes");
    modalPlan?.classList.remove("hidden");
    modalPlan?.classList.add("flex");
  });
</script>

<div class="space-y-5">
  

  <!-- 1. CUENTA DE AHORRO -->
  <section class="rounded-2xl border-2 border-[#1E1B4B] bg-[#FFFFFF] p-5 shadow-[0_4px_0_#1E1B4B]">
    <div class="flex items-start justify-between">
      <div class="flex items-center gap-3">
        <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-[#3B38C4] text-white">
          <svg
            class="h-6 w-6"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z"
            />
          </svg>
        </div>
        <div>
          <h2 class="text-base font-bold text-[#1E1B4B]">Cuenta de Ahorro</h2>
          <p class="text-xs text-[#1E1B4B]/75">Disponible para tu mes</p>
        </div>
      </div>

      <!-- CAMBIA AQUI LA RUTA DE CUENTA DE AHORRO SI LO NECESITAS -->
      <a
        href="/ahorro"
        aria-label="Ir a Ahorro"
        class="text-[#1E1B4B] hover:translate-x-1 transition-transform"
      >
        <svg
          class="h-5 w-5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M14 5l7 7m0 0l-7 7m7-7H3"
          />
        </svg>
      </a>
    </div>

    <div class="mt-5 flex items-end justify-between">
      <p class="font-mono text-3xl font-extrabold tracking-tight text-[#1E1B4B]">
        Bs 3.450,00
      </p>
      <span class="rounded-full border border-[#1E1B4B] bg-white px-3 py-0.5 text-xs font-bold text-[#1E1B4B]">
        Plan activo
      </span>
    </div>

    <!-- Botones Pagar y Cobrar -->
    <div class="mt-4 grid grid-cols-2 gap-3">
      <button
        id="btn-abrir-pagar"
        type="button"
        class="rounded-xl border-2 border-[#1E1B4B] bg-[#3B38C4] py-2 text-sm font-bold text-white shadow-[0_3px_0_#1E1B4B] active:translate-y-0.5"
      >
        Pagar QR
      </button>
      <button
        id="btn-abrir-cobrar"
        type="button"
        class="rounded-xl border-2 border-[#1E1B4B] bg-white py-2 text-sm font-bold text-[#1E1B4B] shadow-[0_3px_0_#1E1B4B] active:translate-y-0.5"
      >
        Cobrar
      </button>
    </div>
  </section>

  <!-- 2. CAJA VIRTUAL HORMIGA -->
  <section class="rounded-2xl border-2 border-[#1E1B4B] bg-white p-5 shadow-[0_4px_0_#1E1B4B]">
    <div class="flex items-start justify-between">
      <div class="flex items-center gap-3">
        <div class="flex h-11 w-11 items-center justify-center rounded-xl border border-[#1E1B4B]/20 bg-[#F4ECE1] text-[#3B38C4]">
          <svg
            class="h-6 w-6"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
            />
          </svg>
        </div>
        <div>
          <h2 class="text-base font-bold text-[#1E1B4B]">
            Caja Virtual Hormiga
          </h2>
          <p class="text-xs text-[#1E1B4B]/75">Ahorros del 5% por ingreso</p>
        </div>
      </div>
      <span class="rounded-full border border-emerald-800 bg-emerald-100 px-2.5 py-0.5 text-xs font-bold text-emerald-900">
        Agua lista
      </span>
    </div>

    <div class="mt-4 flex items-baseline justify-between">
      <p class="font-mono text-2xl font-extrabold text-[#1E1B4B]">Bs 488,00</p>
      <span class="text-xs font-medium text-[#1E1B4B]/75">
        3 subcuentas activas
      </span>
    </div>

    <div class="mt-3 grid grid-cols-3 divide-x divide-[#1E1B4B]/15 rounded-xl border border-[#1E1B4B]/20 bg-[#FAF7F2] py-2.5 text-center">
      <div>
        <p class="text-xs text-[#1E1B4B]/75">Agua</p>
        <p class="mt-0.5 font-mono text-sm font-bold text-emerald-700">Bs 85</p>
      </div>
      <div>
        <p class="text-xs text-[#1E1B4B]/75">Luz</p>
        <p class="mt-0.5 font-mono text-sm font-bold text-[#1E1B4B]">Bs 133</p>
      </div>
      <div>
        <p class="text-xs text-[#1E1B4B]/75">Comida</p>
        <p class="mt-0.5 font-mono text-sm font-bold text-[#1E1B4B]">Bs 270</p>
      </div>
    </div>
  </section>

  <!-- 3. MIS UFVs ACUMULADOS -->
  <section class="rounded-2xl border-2 border-[#1E1B4B] bg-white p-5 shadow-[0_4px_0_#1E1B4B]">
    <div class="flex items-start justify-between">
      <div class="flex items-center gap-3">
        <div class="flex h-11 w-11 items-center justify-center rounded-xl border border-[#1E1B4B]/20 bg-[#F4ECE1] text-[#3B38C4]">
          <svg
            class="h-6 w-6"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"
            />
          </svg>
        </div>
        <div>
          <h2 class="text-base font-bold leading-tight text-[#1E1B4B]">
            Mis UFVs acumulados
          </h2>
          <p class="text-xs text-[#1E1B4B]/75">1 UFV = Bs 2,5418 hoy</p>
        </div>
      </div>
      <span class="rounded-full border border-emerald-800 bg-emerald-100 px-2.5 py-0.5 text-xs font-bold text-emerald-900">
        ↑ +9,04%
      </span>
    </div>

    <div class="mt-4 flex items-baseline justify-between">
      <p class="font-mono text-2xl font-extrabold text-[#1E1B4B]">142,50 UFV</p>
      <p class="font-mono text-sm font-medium text-[#1E1B4B]/75">≈ Bs 362,21</p>
    </div>

    <!-- PON AQUI LA RUTA DE UFVs EN EL href -->
    <a
      href="/ufvs"
      class="mt-4 flex w-full items-center justify-center gap-2 rounded-xl border-2 border-[#1E1B4B] bg-[#3B38C4] py-3 text-sm font-bold text-white shadow-[0_3px_0_#1E1B4B] active:translate-y-0.5"
    >
      <svg
        class="h-5 w-5"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"
        />
      </svg>
      <span>Depositar UFVs vía QR</span>
    </a>
  </section>
</div>

<!-- MODAL PARA PAGAR QR -->
<div
  id="modal-pagar"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4"
>
  <div class="w-full max-w-sm rounded-2xl border-2 border-[#1E1B4B] bg-white p-5 shadow-[0_6px_0_#1E1B4B]">
    <div class="flex items-center justify-between">
      <h3 class="text-lg font-extrabold text-[#1E1B4B]">Pagar con QR</h3>
      <button id="btn-cerrar-pagar" type="button" class="font-bold text-[#1E1B4B]">
        ✕
      </button>
    </div>

    <div class="mt-4 space-y-3 text-center">
      <div class="rounded-xl border-2 border-dashed border-[#3B38C4] bg-[#F4ECE1] p-4">
        <p class="text-xs font-bold text-[#3B38C4]">QR LISTO PARA PAGAR</p>
        <p id="estado-qr" class="mt-1 text-xs text-[#1E1B4B]/80">
          Presiona el botón para simular el pago por QR.
        </p>
        <img src="/img/mascota/qr1.jpeg" alt="" width="300px" style="text-align: center;">
      </div>
      <button
        id="btn-simular-qr"
        type="button"
        class="w-full rounded-xl border-2 border-[#1E1B4B] bg-[#3B38C4] py-2.5 text-sm font-bold text-white shadow-[0_3px_0_#1E1B4B]"
      >
        Simular pago QR e ir a Pagos
      </button>
    </div>
  </div>
</div>

<!-- MODAL PARA COBRAR (SOLO QR + FECHA DE VENCIMIENTO + DETALLES) -->
<div
  id="modal-cobrar"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4"
>
  <div class="w-full max-w-sm rounded-2xl border-2 border-[#1E1B4B] bg-white p-5 shadow-[0_6px_0_#1E1B4B]">
    <div class="flex items-center justify-between">
      <h3 class="text-lg font-extrabold text-[#1E1B4B]">QR para Cobrar</h3>
      <button id="btn-cerrar-cobrar" type="button" class="font-bold text-[#1E1B4B]">
        ✕
      </button>
    </div>

    <div class="mt-4 flex flex-col items-center rounded-xl border-2 border-dashed border-[#3B38C4] bg-[#F4ECE1] p-4 text-center">
      <!-- Cuadro simulado de QR -->
      <div class="grid grid-cols-4 gap-1.5 rounded-lg border border-[#1E1B4B] bg-white p-3">
        <div class="h-5 w-5 bg-[#3B38C4]"></div>
        <div class="h-5 w-5 bg-[#1E1B4B]"></div>
        <div class="h-5 w-5 bg-[#3B38C4]"></div>
        <div class="h-5 w-5 bg-[#1E1B4B]"></div>
        <div class="h-5 w-5 bg-[#1E1B4B]"></div>
        <div class="h-5 w-5 bg-[#3B38C4]"></div>
        <div class="h-5 w-5"></div>
        <div class="h-5 w-5 bg-[#3B38C4]"></div>
        <div class="h-5 w-5 bg-[#3B38C4]"></div>
        <div class="h-5 w-5"></div>
        <div class="h-5 w-5 bg-[#1E1B4B]"></div>
        <div class="h-5 w-5 bg-[#3B38C4]"></div>
      </div>

      <p class="mt-3 text-xs font-bold text-[#1E1B4B]">Titular: Camila · Cuenta de Ahorro</p>
      <p id="vencimiento-qr" class="mt-1 rounded-full border border-[#1E1B4B] bg-white px-3 py-0.5 text-xs font-semibold text-[#3B38C4]">
        Vence: 22/11/2026 · 16:51
      </p>
      <p class="mt-2 font-mono text-[11px] text-[#1E1B4B]/70">
        ID QR: UFV-COB-84920
      </p>
    </div>

    <div class="mt-4 flex gap-2">
      <button
        id="btn-copiar-qsr"
        type="button"
        class="flex-1 rounded-xl border-2 border-[#1E1B4B] bg-[#F4ECE1] py-2 text-xs font-bold text-[#1E1B4B]"
      >
        Compartir
      </button>
      <button
        id="btn-listo-cobrar"
        type="button"
        class="flex-1 rounded-xl border-2 border-[#1E1B4B] bg-[#3B38C4] py-2 text-xs font-bold text-white"
      >
        Listo
      </button>
    </div>
  </div>
</div>


<script>
  const modalPagar = document.getElementById("modal-pagar");
  const modalCobrar = document.getElementById("modal-cobrar");
  const estadoQr = document.getElementById("estado-qr");
  const vencimientoQr = document.getElementById("vencimiento-qr");

  // Abrir y cerrar modal de Pagar QR
  document.getElementById("btn-abrir-pagar")?.addEventListener("click", () => {
    if (estadoQr)
      estadoQr.textContent = "Presiona el botón para simular el pago por QR.";
    modalPagar?.classList.remove("hidden");
    modalPagar?.classList.add("flex");
  });

  document.getElementById("btn-cerrar-pagar")?.addEventListener("click", () => {
    modalPagar?.classList.add("hidden");
    modalPagar?.classList.remove("flex");
  });

  // Simular pago QR y redirigir a Pagos
  document.getElementById("btn-simular-qr")?.addEventListener("click", () => {
    if (estadoQr) estadoQr.textContent = "Procesando pago QR...";
    setTimeout(() => {
      // PON AQUI LA RUTA DE LA PESTAÑA DE PAGOS
      window.location.href = "/pagos";
    }, 700);
  });

  // Abrir modal de Cobrar con fecha de vencimiento (+24 horas)
  document.getElementById("btn-abrir-cobrar")?.addEventListener("click", () => {
    const vence = new Date(Date.now() + 24 * 60 * 60 * 1000);
    const fecha = vence.toLocaleDateString("es-BO");
    const hora = vence.toLocaleTimeString("es-BO", {
      hour: "2-digit",
      minute: "2-digit",
    });

    if (vencimientoQr) {
      vencimientoQr.textContent = `Vence: ${fecha} · ${hora}`;
    }

    modalCobrar?.classList.remove("hidden");
    modalCobrar?.classList.add("flex");
  });

  const cerrarCobrar = () => {
    modalCobrar?.classList.add("hidden");
    modalCobrar?.classList.remove("flex");
  };

  document.getElementById("btn-cerrar-cobrar")?.addEventListener("click", cerrarCobrar);
  document.getElementById("btn-listo-cobrar")?.addEventListener("click", cerrarCobrar);

  document.getElementById("btn-copiar-qr")?.addEventListener("click", (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    navigator.clipboard?.writeText("UFV-COB-84920");
    const textoOriginal = btn.textContent;
    btn.textContent = "¡Copiado!";
    setTimeout(() => {
      btn.textContent = textoOriginal;
    }, 1200);
  });
</script>